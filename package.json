    "@mysten/walrus": "1.2.19",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "ai": "6.0.264",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
