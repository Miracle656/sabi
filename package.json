    "check-prompt": "tsx scripts/check-prompt.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "restore": "tsx scripts/restore.ts",
    "keygen": "tsx scripts/keygen.ts",
    "add-member": "tsx scripts/add-member.ts",
    "members": "tsx scripts/members.ts",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.111",
    "@ai-sdk/openai": "3.0.99",
