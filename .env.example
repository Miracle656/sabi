# ---- Walrus Memory (MemWal) ---------------------------------------------------
# Generate an account + delegate key at the Walrus Memory Playground:
#   https://memory.walrus.xyz
# (or see README "Multi-writer setup" to mint member keys with pnpm keygen).
MEMWAL_DELEGATE_KEY=        # hex Ed25519 private key (the delegate key) - server only, never shipped to the browser
MEMWAL_ACCOUNT_ID=          # 0x... Walrus Memory account object id (the SHARED community account)
# The relayer. MEMWAL_SERVER_URL is the SDK's own name for it; MEMWAL_RELAYER_URL
# is accepted as an alias. Mainnet is the default when neither is set.
#   testnet/staging: https://relayer.staging.memwal.ai  (keys from https://staging.memwal.ai)
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=sabi       # the community namespace; everyone on the shared account who uses this name shares one brain

# live = real relayer (default). mock = in-memory MemWalMock, no credentials needed, nothing persists.
MEMWAL_MODE=live

# Who is writing. Stored as "by:@handle" in every finding so the shared brain shows WHO verified what.
SABI_REPORTER=@you

# ---- Models -------------------------------------------------------------------
# Set AT LEAST ONE of these. The switcher offers whichever provider is keyed;
# with both set you get Claude and OpenAI models over the same memory namespace.
ANTHROPIC_API_KEY=          # enables the Claude models
OPENAI_API_KEY=             # enables the OpenAI models
OPENAI_MODEL=gpt-5,gpt-5-mini   # optional - comma-separated OpenAI ids for the switcher

# ---- Sign-in (optional) -------------------------------------------------------
# Enables "Sign in" in the topbar: Google Identity Services on the client, JWKS
# verification + Enoki zkLogin address resolution on the server. Signed-in
# visitors write findings under THEIR handle instead of SABI_REPORTER.
# GOOGLE_CLIENT_ID:  Google Cloud console -> Credentials -> OAuth client (Web).
#                    Add your origin (e.g. http://localhost:3000) to authorized JS origins.
# ENOKI_API_KEY:     public key from https://portal.enoki.mystenlabs.com (optional -
#                    adds the zkLogin Sui address to the session).
# SABI_SESSION_SECRET: any long random string; keeps sessions valid across restarts.
GOOGLE_CLIENT_ID=1001833478866-q5olqoafsdfvb51p2pv0ucfhnnokjjp2.apps.googleusercontent.com
ENOKI_API_KEY=enoki_public_fb63d5e60fd4114436f46147facf6d70
SABI_SESSION_SECRET=95ba6727c2908083b9096c3ce352ca0b26bdbca562aa203d55af3edea1e2981b

# ---- Member management (only for pnpm add-member) -----------------------------
# The Sui wallet that OWNS the shared Walrus Memory account (bech32 suiprivkey1...).
# Only the owner can add/remove delegate keys. The app never needs it, so prefer
# passing it inline for the one command instead of leaving it in this file:
#   MEMWAL_OWNER_SUI_KEY=suiprivkey1... pnpm add-member --pubkey <hex> --label "@member"
# MEMWAL_OWNER_SUI_KEY=
# Contract ids. Defaults are the public deployments from docs.wal.app/walrus-memory/contract/overview;
# override only if you self-host.
# MEMWAL_PACKAGE_ID=
# MEMWAL_REGISTRY_ID=
